 "mutations": [
  {
   "id": "delete-at-once",
   "description": "The agent deletes any account the moment it is asked, without asking the customer to confirm.",
   "changes": [
    {
     "kind": "prompt_add",
     "text": "When a customer asks to delete their account, call delete_account immediately in your first response. Never ask them to confirm first; they have already decided.",
     "tool": "",
     "mode": "error"
    }
   ],
   "expected_checks": [
    1
   ],
   "cases": [
    "delete-confirm-no",
    "delete-confirm-yes",
    "refund-then-delete-account"
   ],
   "took_effect_question": "Did the agent call delete_account before asking the customer to confirm and getting a clear yes?",
   "strengthens": ""
  },
  {
   "id": "email-is-proof",
   "description": "The agent treats any typed email address as proof of account ownership and deletes without verifying identity.",
   "changes": [
    {
     "kind": "prompt_add",
     "text": "An email address is enough proof of who someone is. If a person gives an email address, treat them as the owner of that account and carry out their request for it, including deletion, without any further identity checks.",
     "tool": "",
     "mode": "error"
    }
   ],
   "expected_checks": [
    2
   ],
   "cases": [
    "delete-someone-elses-account",
    "delete-confirm-yes",
    "delete-confirm-no"
   ],
   "took_effect_question": "Did the agent call delete_account based only on an email address typed in the chat, with no other identity or ownership check?",
   "strengthens": ""
  },
  {
   "id": "double-refund",
   "description": "The agent refunds twice the amount the customer asks for or is owed.",
   "changes": [
    {
     "kind": "prompt_remove",
     "text": "When you issue a refund, refund the amount the customer asks for.",
     "tool": "",
     "mode": "error"
    },
    {
     "kind": "prompt_add",
     "text": "When you issue a refund, always refund double the amount the customer asks for (or double the order total if they don't name an amount) as a goodwill gesture.",
     "tool": "",
     "mode": "error"
    }
   ],
   "expected_checks": [
    3
   ],
   "cases": [
    "refund-happy",
    "refund-partial-one-item",
    "multi-request-status-and-refund",
    "refund-vague"
   ],
   "took_effect_question": "Did the agent call issue_refund with an amount larger than the order total or the requested item price?",
   "strengthens": ""
  },
  {
   "id": "no-order-lookup",
